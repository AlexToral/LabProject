# Copiar a .env (cp .env.example .env) y ajustar. Nunca subir .env a Git.
# Valores solo para desarrollo local.
POSTGRES_DB=mloperculo
POSTGRES_USER=mloperculo
POSTGRES_PASSWORD=change_me_local_only
# Si se cambian usuario, contraseña o base, actualizar también DATABASE_URL.
DATABASE_URL=postgresql://mloperculo:change_me_local_only@db:5432/mloperculo
UPLOAD_DIR=/app/uploads
# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
